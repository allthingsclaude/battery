<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Runtime permission on API 33+; without it nothing posts at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The one that makes a notification eligible for the Now Bar, the lock screen,
      the AOD and the status-bar chip. Non-runtime: it is granted at install, but
      the user can revoke promotion per-app in Settings, which is why the app has
      to check canPostPromotedNotifications() rather than assume.
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
      The service exists exactly as long as its notification is on the lock
      screen, so the notification is the user-visible justification for it.

      specialUse rather than dataSync: dataSync is capped at 6h per 24h on
      Android 15+, which a back-to-back coding day would exhaust, and there is no
      graceful degradation — the system throws. specialUse carries no timeout,
      and distribution is off-Play so its Play Console justification doesn't
      apply.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Battery">

        <!--
          Samsung's private ongoing-activity pipeline, which is what actually
          drives the Now Bar and the status-bar pill on One UI. Decompilation of
          Samsung Clock / Health / Voice Recorder shows they declare this and use
          `android.ongoingActivityNoti.*` extras — and use none of the AOSP
          promoted-notification APIs at all. So One UI has two pipelines, and the
          AOSP one we satisfy reaches only the lock-screen card.

          Undocumented and quite possibly package-whitelisted, so this is a cheap
          experiment rather than a load-bearing dependency: an unrecognised
          meta-data key is inert. See tasks/plans/PLAN_01 → Now Bar findings.
        -->
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <service
            android:name=".live.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the live Claude Code session card on the lock screen current while a session is active." />
        </service>

        <receiver
            android:name=".live.CardDismissedReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.BatteryWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Phase 0 harness, kept and reachable from the dashboard's
          Diagnostics button rather than deleted: the Now Bar questions in
          android/NOW_BAR.md are still open, and answering them needs the
          ability to post a card at an arbitrary percentage on demand.
          Not exported — nothing outside the app should be able to launch it.
        -->
        <activity
            android:name=".SpikeActivity"
            android:exported="false"
            android:label="Battery diagnostics" />
    </application>
</manifest>
