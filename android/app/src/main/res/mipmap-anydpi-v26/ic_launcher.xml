<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon. `mipmap`, not `drawable`, because density splits strip
  unused `drawable-*dpi` buckets and a launcher may ask for a density the
  installed split no longer carries — mipmap resources are exempt.

  The foreground is the shared mark sized to 55dp on the 108dp canvas: the
  largest box of its aspect ratio (0.654) that fits inside the 66dp circle every
  mask is guaranteed to leave visible. That is 77% of the 72dp a launcher
  actually draws, which is where iOS puts it too (78%) — the outer 18dp per side
  is bleed for mask animation and parallax and is never shown, so sizing against
  the full 108 canvas would make the mark look small for no reason.

  `<monochrome>` is only read from API 33, and minSdk here is 31. The two
  versions that ignore it skip the tag rather than failing to inflate, which is
  why it sits in the v26 file rather than a second v33 copy of everything.

  No `ic_launcher_round`: that is consulted on API 25-27 for legacy icons, and
  every device this app installs on masks the adaptive icon itself.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
